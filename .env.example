# Offline mode requires no variables. This file is documentation; it is NOT auto-loaded.
# Live mode defaults to DashScope. Set variables in your shell, never commit a real key.
AGENT_API_KEY=
AGENT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AGENT_MODEL=qwen-plus
# If AGENT_API_KEY is absent, the DashScope endpoint uses DASHSCOPE_API_KEY.
# Other endpoints use OPENAI_API_KEY as fallback.
# A Chat Completions-compatible endpoint with native function calling is required.
# AGENT_BASE_URL=https://api.openai.com/v1
# AGENT_MODEL=gpt-4.1-mini
